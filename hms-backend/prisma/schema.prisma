// This tells Prisma to connect to MongoDB
datasource db {
  provider = "mongodb"
  url      = "mongodb://127.0.0.1:27017/hms_database"
}

// This tells Prisma to generate JavaScript code for us
generator client {
  provider = "prisma-client-js"
}

// -------------------------
// OUR DATABASE MODELS
// -------------------------

model Patient {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  age          String        // Changed to String to perfectly match your backend fix
  gender       String
  phone        String
  status       String        @default("Active")
  
  appointments Appointment[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Doctor {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  specialization String
  phone          String
  email          String?       @unique // Optional, but good to have
  status         String        @default("Active")
  
  appointments   Appointment[] 
}

model Appointment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  time      String
  reason    String
  status    String   @default("Scheduled")

  // The relational links:
  patientId String   @db.ObjectId
  patient   Patient  @relation(fields: [patientId], references: [id])
  
  doctorId  String   @db.ObjectId
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}
model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String // We will store an encrypted hash here, never the real password!
}
model Invoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @unique // We will auto-generate INV-2026-001
  patient   String
  type      String
  amount    Float
  status    String   @default("Pending")
  date      DateTime @default(now())
}
model Medicine {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  medId    String   @unique // We will auto-generate MED-1234
  name     String
  category String
  stock    Int
  price    Float
  status   String
  addedAt  DateTime @default(now())
}
model ClinicalRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recordId     String   @unique // Auto-generated REC-123
  patient      String
  doctor       String
  diagnosis    String
  prescription String
  date         DateTime @default(now())
}

model LabTest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  labId     String   @unique // Auto-generated LAB-123
  patient   String
  test      String
  status    String   @default("Pending")
  result    String   @default("-")
  date      DateTime @default(now())
}
model Prescription {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  patient      String
  medicine     String
  dosage       String
  instructions String
}